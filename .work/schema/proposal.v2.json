{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-os.dev/schema/proposal.v2.json",
  "title": "Work ledger proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "order",
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "idea_ids",
    "roadmaps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "kind": {
      "const": "proposal"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "string",
      "pattern": "^p-[0-9]{6}-[0-9]{2,}-[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "accepted",
        "parked",
        "declined",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "idea_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^i-[0-9]{6}-[0-9]{2,}-[a-z0-9][a-z0-9-]*$"
      },
      "maxItems": 100
    },
    "roadmaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^r-[0-9]{6}-[0-9]{2,}-[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
