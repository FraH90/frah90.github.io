---
import { getAllCategories, getAllPosts, getCategoryRefinements } from '../../lib/posts';
const categories = await getAllCategories();
const posts = await getAllPosts();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<details name="reading-panels" class="discovery-panel reading-panel" id="discovery-panel" data-reading-panel="right">
  <summary aria-label="Explore articles and search" title="Explore articles and search">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M9 12h11M4 17h16"/></svg>
  </summary>
  <aside aria-label="Explore articles and search" class="discovery-drawer panel-drawer">
    <div class="drawer-heading"><h2 id="discovery-heading">Explore</h2><button type="button" class="drawer-close panel-close" aria-label="Close explore panel" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form action="/search" method="get" role="search" aria-label="Search articles" class="drawer-search">
      <label class="sr-only" for="drawer-query">Search articles</label>
      <input id="drawer-query" type="search" name="q" maxlength="200" placeholder="Search articles" autocomplete="off" />
      <button type="submit" aria-label="Search articles"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
    </form>
    <nav aria-label="Article categories">
      <h3>Categories</h3>
      <ul class="category-tree">{categories.map(category => {
        const refinements = getCategoryRefinements(category.slug, posts);
        return <li class="drawer-category-row" style={`--category-color: var(${category.tone})`}>
          <a class="drawer-category-link" href={`/categories/${category.slug}`} aria-current={path.startsWith(`/categories/${category.slug}`) ? (path === `/categories/${category.slug}` ? 'page' : 'true') : undefined}><span class="category-dot" aria-hidden="true"></span><span>{category.label}</span></a>
          {refinements.length > 0 && <details class="drawer-category" name="explore-categories" open={path.startsWith(`/categories/${category.slug}`)}>
            <summary aria-label={`Show tags for ${category.label}`}><span class="category-chevron" aria-hidden="true">+</span></summary>
            <div class="category-refinements">
              <ul class="tag-badges">{refinements.map(tag => <li><a href={`/categories/${category.slug}/${tag.slug}`} class="tag-badge" aria-current={path === `/categories/${category.slug}/${tag.slug}` ? 'page' : undefined}>{tag.label}</a></li>)}</ul>
            </div>
          </details>}
        </li>;
      })}</ul>
    </nav>
  </aside>
</details>
<style is:global>
.discovery-drawer h2 { color: var(--ink); font-size: 1rem; font-weight: 500; }
.discovery-drawer .drawer-search { display: flex; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--rule-strong); }
.discovery-drawer input { width: 100%; min-width: 0; padding: .75rem 0; color: var(--ink); font-size: .875rem; background: transparent; }
.discovery-drawer .drawer-search button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; color: var(--muted); cursor: pointer; }
.discovery-drawer h3 { font-size: .625rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin: 1.5rem 0 .5rem; }
.category-tree { display: grid; gap: .25rem; }
.drawer-category-row { position: relative; min-height: 44px; }
.drawer-category-link { position: absolute; z-index: 1; top: 0; left: 0; display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; color: var(--body); font-size: .8125rem; text-underline-offset: .25em; }
.drawer-category-link:hover { color: var(--ink); text-decoration: underline; }
.discovery-drawer .drawer-category > summary { display: flex; align-items: center; justify-content: flex-end; width: 100%; height: auto; min-height: 44px; border-radius: 0; font-size: .8125rem; color: var(--body); background: transparent; list-style: none; }
.drawer-category > summary::-webkit-details-marker { display: none; }
.category-dot { width: 5px; height: 5px; background: var(--category-color); border-radius: 50%; flex-shrink: 0; }
.category-chevron { font-size: .875rem; color: var(--muted); }
.drawer-category[open] .category-chevron { font-size: 0; }
.drawer-category[open] .category-chevron::after { content: '−'; font-size: .875rem; }
.category-refinements { padding: .1rem 0 .9rem 1rem; }
.discovery-drawer :is(a,summary):focus-visible { outline: none; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
.discovery-drawer a[aria-current] { text-decoration: underline; text-underline-offset: .25em; }
</style>
