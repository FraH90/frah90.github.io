---
import { getAllCategories } from '../../lib/posts';
const topics = await getAllCategories();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<details class="discovery-panel" id="discovery-panel">
  <summary aria-label="Topics and search" title="Topics and search">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16M18 8h.01M18 12h.01M18 16h.01"/></svg>
    <span class="panel-trigger-text">Topics</span>
  </summary>
  <aside aria-label="Topics and search" class="discovery-drawer">
    <div class="drawer-heading"><h2>Explore</h2><button type="button" class="drawer-close" aria-label="Close topics panel" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form action="/search" method="get" role="search" aria-label="Search from topics panel" class="drawer-search">
      <label class="sr-only" for="drawer-query">Search articles</label>
      <input id="drawer-query" type="search" name="q" maxlength="200" placeholder="Search articles" autocomplete="off" />
      <button type="submit" aria-label="Search articles"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
    </form>
    <nav aria-label="Article topics">
      <h3>Topics</h3>
      <ul>
        <li><a href="/blog" aria-current={path === '/blog' ? 'page' : undefined}>All topics<span aria-hidden="true">→</span></a></li>
        {topics.map(topic => <li><a href={`/blog/${topic.slug}`} aria-current={path === `/blog/${topic.slug}` ? 'page' : path.startsWith(`/blog/${topic.slug}/`) ? 'true' : undefined}>{topic.label}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </nav>
  </aside>
</details>
<script>
  const panel = document.querySelector<HTMLDetailsElement>('#discovery-panel');
  const trigger = panel?.querySelector('summary');
  const close = panel?.querySelector<HTMLButtonElement>('.drawer-close');
  if (panel && close) {
    close.hidden = false;
    close.addEventListener('click', () => { panel.open = false; trigger?.focus(); });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && panel.open) { event.preventDefault(); panel.open = false; trigger?.focus(); }
    });
    document.addEventListener('pointerdown', event => {
      if (panel.open && event.target instanceof Node && !panel.contains(event.target)) panel.open = false;
    });
  }
</script>
<style>
summary { display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; min-width: 44px; padding: .5rem .7rem; list-style: none; border: 1px solid var(--rule-strong); border-radius: .5rem; color: var(--muted); cursor: pointer; font-size: .875rem; }
summary::-webkit-details-marker { display: none; }
summary:hover, details[open] summary { color: var(--ink); background: var(--elevated); }
.discovery-drawer { position: fixed; z-index: 60; right: 1rem; top: 5rem; width: min(22rem, calc(100vw - 2rem)); max-height: calc(100dvh - 6rem); overflow-y: auto; overscroll-behavior: contain; padding: 1.25rem; border: 1px solid var(--rule-strong); border-radius: .75rem; background: var(--surface); box-shadow: 0 1.5rem 4rem #0005; color: var(--body); }
.drawer-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
h2 { color: var(--ink); font-size: 1.125rem; font-weight: 500; }
.drawer-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: .4rem; color: var(--muted); cursor: pointer; }
.drawer-close[hidden] { display: none; }
.drawer-close:hover { color: var(--ink); background: var(--elevated); }
.drawer-search { display: flex; align-items: center; margin-bottom: 1.5rem; background: var(--page); border: 1px solid var(--rule-strong); border-radius: .5rem; }
input { width: 100%; min-width: 0; padding: .75rem; color: var(--ink); font-size: 1rem; background: transparent; border-radius: .5rem; }
.drawer-search button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 44px; min-height: 44px; color: var(--muted); cursor: pointer; }
.drawer-search button:hover { color: var(--accent); }
h3 { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .5rem; }
ul { display: grid; gap: .25rem; }
nav a { display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: .75rem; padding: .65rem .75rem; border-radius: .4rem; color: var(--body); font-size: .875rem; }
nav a span { opacity: .5; }
nav a:hover { background: var(--elevated); color: var(--ink); }
nav a[aria-current] { background: var(--elevated); color: var(--accent); }
@media (max-width: 639px) { .panel-trigger-text { display: none; } }
</style>
