---
import { getAllCategories } from '../../lib/posts';
const topics = await getAllCategories();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<details name="reading-panels" class="discovery-panel reading-panel" id="discovery-panel" data-reading-panel="right">
  <summary aria-label="Topics and search" title="Topics and search">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M9 12h11M4 17h16"/></svg>
  </summary>
  <aside aria-label="Topics and search" class="discovery-drawer panel-drawer">
    <div class="drawer-heading"><h2 id="discovery-heading">Explore</h2><button type="button" class="drawer-close panel-close" aria-label="Close topics panel" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form action="/search" method="get" role="search" aria-label="Search from topics panel" class="drawer-search">
      <label class="sr-only" for="drawer-query">Search articles</label>
      <input id="drawer-query" type="search" name="q" maxlength="200" placeholder="Search articles" autocomplete="off" />
      <button type="submit" aria-label="Search articles"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
    </form>
    <nav aria-label="Article topics">
      <h3>Topics</h3>
      <ul>
        <li><a href="/blog" aria-current={path === '/blog' ? 'page' : undefined}>All topics<span aria-hidden="true">→</span></a></li>
        {topics.map(topic => <li><a href={`/blog/${topic.slug}`} aria-current={path === `/blog/${topic.slug}` ? 'page' : path.startsWith(`/blog/${topic.slug}/`) ? 'true' : undefined}>{topic.label}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </nav>
  </aside>
</details>
<style is:global>
.discovery-drawer .drawer-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
.discovery-drawer h2 { color: var(--ink); font-size: 1.125rem; font-weight: 500; }
.discovery-drawer .drawer-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--muted); cursor: pointer; transition: background-color 160ms; }
.discovery-drawer .drawer-close[hidden] { display: none; }
.discovery-drawer .drawer-close:hover { color: var(--ink); background: var(--elevated); }
.discovery-drawer .drawer-search { display: flex; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); }
.discovery-drawer input { width: 100%; min-width: 0; padding: .75rem 0; color: var(--ink); font-size: 1rem; background: transparent; }
.discovery-drawer .drawer-search button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; color: var(--muted); cursor: pointer; }
.discovery-drawer .drawer-search button:hover { color: var(--accent); }
.discovery-drawer h3 { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .75rem; }
.discovery-drawer ul { display: grid; gap: .25rem; }
.discovery-drawer nav a { display: flex; align-items: center; justify-content: space-between; min-height: 48px; gap: .75rem; padding: .65rem .5rem; border-bottom: 1px solid var(--rule); color: var(--body); font-size: .9375rem; transition: color 160ms, background-color 160ms; }
.discovery-drawer nav a span { opacity: .5; }
.discovery-drawer nav a:hover { color: var(--ink); background: var(--elevated); }
.discovery-drawer nav a[aria-current] { color: var(--accent); }
</style>
