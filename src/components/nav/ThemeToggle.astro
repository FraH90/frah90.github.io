<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme" hidden>
  <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </svg>
  <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />
  </svg>
  <span class="theme-toggle-label" aria-hidden="true">Light</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const label = button?.querySelector('.theme-toggle-label');
  const root = document.documentElement;
  const readPreference = () => {
    try { return localStorage.getItem('frah90-theme') === 'light' ? 'light' : 'dark'; }
    catch { return root.dataset.theme === 'light' ? 'light' : 'dark'; }
  };
  const applyTheme = (theme: string) => {
    root.dataset.theme = theme;
    const next = theme === 'light' ? 'dark' : 'light';
    const action = `Switch to ${next} theme`;
    button?.setAttribute('aria-label', action);
    button?.setAttribute('title', action);
    if (label) label.textContent = next === 'light' ? 'Light' : 'Dark';
    window.dispatchEvent(new CustomEvent('themechange'));
  };
  if (button) {
    applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark');
    button.hidden = false;
    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      applyTheme(theme);
      try { localStorage.setItem('frah90-theme', theme); } catch { /* Choice still works for this page. */ }
    });
    window.addEventListener('storage', event => {
      if (event.key === 'frah90-theme' || event.key === null) applyTheme(readPreference());
    });
    window.addEventListener('pageshow', () => applyTheme(readPreference()));
  }
</script>
