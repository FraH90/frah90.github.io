---
const navLinks = [
  { href: '/blog',  label: 'Blog'  },
  { href: '/about', label: 'About' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(href);
---

<header class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur border-b border-zinc-900">
  <nav class="max-w-4xl mx-auto px-6 h-14 flex items-center">
    <ul class="hidden sm:flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'text-sm transition-colors',
              isActive(href)
                ? 'text-zinc-100'
                : 'text-zinc-500 hover:text-zinc-200',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
