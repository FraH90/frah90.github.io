---
import { siteName } from '../../lib/site';

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur border-b border-zinc-800">
  <nav aria-label="Main navigation" class="max-w-4xl mx-auto px-6 min-h-16 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
    <a href="/" class="inline-flex min-h-11 items-center font-medium tracking-tight text-zinc-100" aria-label={`${siteName} — home`}>
      {siteName}<span class="ml-1 text-emerald-400" aria-hidden="true">.</span>
    </a>
    <ul class="flex items-center gap-5 sm:gap-7">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href}
            aria-current={isActive(href) ? (current === href ? 'page' : 'true') : undefined}
            class:list={[
              'inline-flex min-h-11 items-center text-sm transition-colors underline-offset-8 decoration-emerald-400',
              isActive(href) ? 'text-zinc-100 underline' : 'text-zinc-400 hover:text-zinc-100',
            ]}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
