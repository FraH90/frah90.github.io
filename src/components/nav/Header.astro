---
import ThemeToggle from './ThemeToggle.astro';
import DiscoveryPanel from './DiscoveryPanel.astro';
import TableOfContents from '../article/TableOfContents.astro';
import { siteName } from '../../lib/site';
const { articleContents = [] } = Astro.props;

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header sticky top-0 z-50 bg-page/95 border-b border-rule">
  <nav aria-label="Main navigation" class="header-nav">
    {articleContents.length >= 2 ? <TableOfContents headings={articleContents} /> : <span aria-hidden="true" />}
    <div class="header-center site-shell">
    <a href="/" class="inline-flex min-h-11 items-center font-medium tracking-tight text-ink" aria-label={`${siteName} — home`}>
      {siteName}<span class="ml-1 text-accent" aria-hidden="true">.</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-3 sm:gap-6">
        {navLinks.map(({ href, label }) => (
          <li>
            <a href={href}
              aria-current={isActive(href) ? (current === href ? 'page' : 'true') : undefined}
              class:list={[
                'inline-flex min-h-11 items-center text-sm transition-colors underline-offset-8 decoration-accent',
                isActive(href) ? 'text-ink underline' : 'text-muted hover:text-ink',
              ]}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
    </div>
    <DiscoveryPanel />
  </nav>
</header>

<script>
  import "../../lib/reading-panels";
</script>
