---
const navLinks = [
  { href: '/',         label: 'Home'     },
  { href: '/projects', label: 'Projects' },
  { href: '/blog',     label: 'Writing'  },
  { href: '/about',    label: 'About'    },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur border-b border-zinc-900">
  <nav class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors" style="font-family: 'Lora', Georgia, serif; font-style: italic;">
      fh
    </a>
    <ul class="hidden sm:flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'text-sm transition-colors',
              isActive(href)
                ? 'text-zinc-100'
                : 'text-zinc-500 hover:text-zinc-200',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
