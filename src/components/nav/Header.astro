---
import ThemeToggle from './ThemeToggle.astro';
import { siteName } from '../../lib/site';

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-page/95 backdrop-blur border-b border-rule">
  <nav aria-label="Main navigation" class="site-shell min-h-16 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 py-2">
    <a href="/" class="inline-flex min-h-11 items-center font-medium tracking-tight text-ink" aria-label={`${siteName} — home`}>
      {siteName}<span class="ml-1 text-accent" aria-hidden="true">.</span>
    </a>
    <div class="flex items-center gap-3 sm:gap-6">
      <ul class="flex items-center gap-4 sm:gap-7">
        {navLinks.map(({ href, label }) => (
          <li>
            <a href={href}
              aria-current={isActive(href) ? (current === href ? 'page' : 'true') : undefined}
              class:list={[
                'inline-flex min-h-11 items-center text-sm transition-colors underline-offset-8 decoration-accent',
                isActive(href) ? 'text-ink underline' : 'text-muted hover:text-ink',
              ]}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
