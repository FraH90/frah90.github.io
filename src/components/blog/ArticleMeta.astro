---
import type { CollectionEntry } from 'astro:content';
import { getTopic } from '../../lib/topics';
import TagBadges from './TagBadges.astro';
const { post, longDate = false } = Astro.props as { post: CollectionEntry<'blog'>; longDate?: boolean };
const category = getTopic(post.data.category);
const tooltip = longDate ? 'demo-explanation' : `demo-${post.id.replaceAll('/', '-')}`;
---
<div class="card-meta">
  <details class="category-menu" style={`--category-color: var(${category.tone})`}>
    <summary class="category-badge" aria-label={`${category.label} — show article tags`}>{category.label}</summary>
    <div class="category-popover">
      <a class="category-all" href={`/categories/${category.slug}`}>All {category.label} articles</a>
      <TagBadges category={category.slug} tags={post.data.tags} demo={post.data.demo} demoTooltip={tooltip} />
    </div>
  </details>
  <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: longDate ? 'long' : 'short', day: 'numeric', timeZone: 'UTC' })}</time>
</div>
