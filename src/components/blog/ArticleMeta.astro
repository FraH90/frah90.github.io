---
import type { CollectionEntry } from 'astro:content';
import { getTopic } from '../../lib/topics';
import { demoNotice } from '../../lib/article-status';
const { post, longDate = false } = Astro.props as { post: CollectionEntry<'blog'>; longDate?: boolean };
const category = getTopic(post.data.category);
const tooltip = longDate ? 'demo-explanation' : `demo-${post.id.replaceAll('/', '-')}`;
---
<div class="card-meta">
  <a class:list={['category-label', category.color]} href={`/categories/${category.slug}`}>{category.label}</a>
  <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: longDate ? 'long' : 'short', day: 'numeric', timeZone: 'UTC' })}</time>
  {post.data.demo && <span class="demo-info"><button type="button" class="demo-badge" aria-describedby={tooltip}>Demo</button><span id={tooltip} class="demo-tooltip" role="tooltip">{demoNotice}</span></span>}
</div>
<script>
  for (const info of document.querySelectorAll<HTMLElement>('.demo-info')) {
    const reset = () => { delete info.dataset.dismissed; };
    info.addEventListener('mouseleave', reset);
    info.addEventListener('focusout', reset);
    info.addEventListener('keydown', event => { if (event.key === 'Escape') info.dataset.dismissed = 'true'; });
  }
</script>
