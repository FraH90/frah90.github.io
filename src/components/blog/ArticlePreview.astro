---
import type { CollectionEntry } from 'astro:content';
import { demoExamples } from '../../lib/demo-examples';
import { chartGeometry } from '../../lib/chart-geometry';
import { getTopic } from '../../lib/topics';
interface Props { post: CollectionEntry<'blog'>; eager?: boolean; interactive?: boolean; }
const { post, eager = false, interactive = false } = Astro.props;
const preview = post.data.preview;
const demoById = {
  'antennas/phased-array-basics': 'array', 'rf/transmission-line-theory': 'transmission',
  'optics/gaussian-beam-intuition': 'gaussian', 'dsp/spectral-leakage': 'fourier',
} as const;
const kind = demoById[post.id as keyof typeof demoById];
const example = kind ? demoExamples[kind] : undefined;
const sourceSpec = example?.charts[kind === 'fourier' ? 1 : 0];
const spec = sourceSpec ? { ...sourceSpec, height: 420 } : undefined;
const geometry = spec ? chartGeometry(spec) : undefined;
const isWorkflow = post.id === 'ml/ml-for-signal-data';
const steering = interactive && kind === 'array' && !preview && !post.data.coverImage;
const image = preview?.kind === 'image' ? preview.src : preview?.kind === 'gif' ? preview.poster : post.data.coverImage;
---
<div class:list={["preview-media", { "preview-interactive": !!steering }]} style={`--accent: var(${getTopic(post.data.category).tone}); --color-accent: var(--accent)`}>
  {preview?.kind === 'video' ? <video controls playsinline preload="metadata" poster={preview.poster} aria-label={preview.alt}><source src={preview.src} /><a href={preview.src}>Open video preview</a></video>
    : image ? <>
      <img src={image} alt={preview?.alt ?? `Article preview: ${post.data.title}`} width={preview && 'width' in preview ? preview.width : 960} height={preview && 'height' in preview ? preview.height : 600} loading={eager ? 'eager' : 'lazy'} decoding="async" data-motion-src={preview?.kind === 'gif' ? preview.src : undefined} data-still-src={preview?.kind === 'gif' ? preview.poster : undefined} />
      {preview?.kind === 'gif' && <button type="button" class="preview-toggle" data-preview-toggle aria-pressed="false" hidden>Play preview</button>}
    </>
    : spec && geometry ? <>
      <svg class:list={{ 'preview-chart-thumbnail': !steering }} viewBox={steering ? "0 0 960 540" : "0 0 960 600"} role="img" aria-label={`${spec.title}. ${spec.description} ${example!.parameters}`}>
        {steering && <text x="74" y="32" class="preview-figure-name">Calculated · 8 elements · d/λ = 0.5</text>}
        <g transform="translate(0 65)">
          {geometry.xTicks.filter((_, index) => steering || index % 2 === 0).map(tick => <><path d={`M${tick.position} 20V356`} class="preview-grid" />{steering && <text x={tick.position} y="386" text-anchor="middle" class="preview-tick">{tick.label}</text>}</>)}
          {geometry.yTicks.filter((_, index) => steering || index % 2 === 0).map(tick => <><path d={`M74 ${tick.position}H940`} class="preview-grid" />{steering && <text x="66" y={tick.position + 7} text-anchor="end" class="preview-tick">{Number(tick.label) === 0 ? '' : tick.label}</text>}</>)}
          {geometry.paths.map(trace => <path d={trace.path} fill="none" stroke={trace.color} stroke-width="2.5" stroke-dasharray={trace.dashed ? '10 7' : undefined} stroke-linejoin="round" data-steering-trace={steering ? true : undefined} />)}
          <text x="74" y="0" class="preview-axis">{kind === 'array' ? '|AF|' : spec.yLabel}</text>
          <text x="510" y={steering ? 440 : 425} text-anchor="middle" class="preview-axis">{spec.xLabel}</text>
        </g>
      </svg>
      {!steering && <span class="preview-context">Calculated reference</span>}
    </>
    : isWorkflow ? <>
      <svg viewBox="0 0 960 600" role="img" aria-label="Illustrative signal machine-learning workflow: signal, features, model, evaluation. This is a conceptual diagram, not a measured result.">
        <path d="M80 280h70l15-50 20 100 20-90 20 80 20-45h65M345 280h90m180 0h90" class="workflow-line" />
        <rect x="435" y="225" width="180" height="110" rx="8" class="workflow-box" />
        <rect x="705" y="225" width="180" height="110" rx="8" class="workflow-box" />
        <text x="525" y="290" text-anchor="middle" class="workflow-label">Features</text>
        <text x="795" y="290" text-anchor="middle" class="workflow-label">Model</text>
        <path d="M795 335v100H190v-90" class="workflow-line workflow-feedback" />
        <text x="480" y="480" text-anchor="middle" class="workflow-label">Evaluate</text>
      </svg>
      <span class="preview-context">Illustrative workflow</span>
    </> : <div class="preview-placeholder"><span>Technical notes</span><p>{post.data.title}</p></div>}
{steering && <div class="steering-preview" data-steering-preview hidden>
  <div class="steering-caption"><label for="featured-steering">Steering angle</label><output for="featured-steering">90°</output></div>
  <input id="featured-steering" type="range" min="45" max="135" value="90" step="1" aria-valuetext="90 degrees from the array axis" />
  <div class="steering-limits" aria-hidden="true"><span>45°</span><span>135°</span></div>
</div>}
</div>
<script>
  import { computeArray } from '../../lib/demo-models';
  import { arrayChart } from '../../lib/demo-charts';
  import { chartGeometry } from '../../lib/chart-geometry';
  for (const controls of document.querySelectorAll<HTMLElement>('[data-steering-preview]')) {
    const input = controls.querySelector<HTMLInputElement>('input')!;
    const output = controls.querySelector('output')!;
    const preview = controls.closest('.preview-media')!;
    const trace = preview.querySelector('[data-steering-trace]')!;
    controls.hidden = false;
    let pending = false;
    input.addEventListener('input', () => {
      const angle = Number(input.value);
      output.textContent = `${angle}°`;
      input.setAttribute('aria-valuetext', `${angle} degrees from the array axis`);
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        const angle = Number(input.value);
        const spec = { ...arrayChart(computeArray(8, .5, -Math.PI * Math.cos(angle * Math.PI / 180))), height: 420 };
        trace.setAttribute('d', chartGeometry(spec).paths[0].path);
        preview.querySelector('svg')!.setAttribute('aria-label', `Calculated uniform eight-element isotropic array, half-wavelength spacing, steered to ${angle} degrees from the array axis. Normalized magnitude versus angle.`);
      });
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-preview-toggle]')) {
    const image = button.parentElement!.querySelector<HTMLImageElement>('img')!;
    button.hidden = false;
    const stop = () => { image.src = image.dataset.stillSrc!; button.textContent = 'Play preview'; button.setAttribute('aria-pressed', 'false'); };
    button.addEventListener('click', () => {
      if (button.getAttribute('aria-pressed') === 'true') stop();
      else { image.src = image.dataset.motionSrc!; button.textContent = 'Pause preview'; button.setAttribute('aria-pressed', 'true'); }
    });
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', stop);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
  }
</script>
