---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const headings = Astro.props.headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
{headings.length >= 2 && (
  <details name="reading-panels" class="article-contents reading-panel" id="article-contents" data-reading-panel="left" data-pagefind-ignore>
    <summary aria-label="Article contents" title="Article contents">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M12 8h6M12 12h6M12 16h4"/></svg>
    </summary>
    <aside class="panel-drawer contents-drawer" aria-label="Article contents">
      <div class="drawer-heading"><h2 id="contents-heading">Contents</h2><button type="button" class="panel-close" aria-label="Close article contents" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <nav aria-label="Article contents"><ul>
        {headings.map(heading => <li class:list={{ 'contents-subsection': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ul></nav>
    </aside>
  </details>
)}
