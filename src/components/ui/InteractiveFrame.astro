---
interface Props {
  label?: string;
}
const { label = 'Interactive' } = Astro.props;
---

<div class="not-prose my-8 rounded-xl border border-rule bg-surface/60 overflow-hidden">
  <div class="border-b border-rule px-4 py-2 flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-accent/60"></span>
    <span class="text-[11px] font-mono text-muted uppercase tracking-widest">{label}</span>
  </div>
  <div class="p-5">
    <slot />
  </div>
</div>
