---
import {
  chartBox,
  chartGeometry,
  type ChartSpec,
} from "../../lib/chart-geometry";
interface Props {
  spec: ChartSpec;
}
const { spec } = Astro.props;
const { xTicks, yTicks, paths } = chartGeometry(spec);
const { width, height, left, right, top, bottom } = chartBox;
---

<figure class="scientific-chart">
  <figcaption class="text-sm text-ink mb-3">{spec.title}</figcaption>
  <p class="chart-scroll-hint">Scroll horizontally to see the full plot.</p>
  <div
    class="chart-scroll"
    tabindex="0"
    role="region"
    aria-label={`${spec.title} — scroll horizontally on small screens`}
  >
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`${spec.title}. ${spec.description}`}
    >
      {
        yTicks.map((t) => (
          <g>
            <>
              <line
                x1={left}
                x2={width - right}
                y1={t.position}
                y2={t.position}
                class="chart-grid"
              />
              <text x={left - 10} y={t.position + 5} text-anchor="end">
                {t.label}
              </text>
            </>
          </g>
        ))
      }
      {
        xTicks.map((t) => (
          <g>
            <>
              <line
                x1={t.position}
                x2={t.position}
                y1={top}
                y2={height - bottom}
                class="chart-grid"
              />
              <text
                x={t.position}
                y={height - bottom + 24}
                text-anchor="middle"
              >
                {t.label}
              </text>
            </>
          </g>
        ))
      }
      {
        paths.map((t) => (
          <path
            d={t.path}
            fill="none"
            stroke={t.color}
            stroke-width="2"
            stroke-dasharray={t.dashed ? "6 4" : undefined}
          />
        ))
      }
      <text
        x={left + (width - left - right) / 2}
        y={height - 10}
        text-anchor="middle">{spec.xLabel}</text
      >
      <text
        transform={`translate(19 ${top + (height - top - bottom) / 2}) rotate(-90)`}
        text-anchor="middle">{spec.yLabel}</text
      >
    </svg>
  </div>
  <ul class="chart-legend" aria-label="Plotted quantities">
    {
      spec.traces.map((t) => (
        <li>
          <span
            aria-hidden="true"
            style={`border-color:${t.color};border-top-style:${t.dashed ? "dashed" : "solid"}`}
          />
          {t.label}
        </li>
      ))
    }
  </ul>
  <p class="text-sm text-muted mt-3 leading-relaxed">{spec.description}</p>
</figure>
