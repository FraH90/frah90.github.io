---
import BaseLayout from '../layouts/BaseLayout.astro';
const versions = [
  { id: 'original', title: 'Original — before the roadmap', height: '574px' },
  { id: 'current', title: 'Current version', height: '914px' },
];
---
<BaseLayout title="Phased-array design comparison — FraH90" description="Temporary visual comparison of the original and current phased-array demos." noindex>
  <div class="review">
    <h1>Phased-array demo comparison</h1>
    <p>The same article and demo width in both versions. The original restores the Plotly demo and controls from before the roadmap. These are screenshots; pictured controls are not interactive. Select any image to open it at full size.</p>
    <input id="boxes" type="radio" name="view" checked /><label for="boxes">Demo boxes</label>
    <input id="pages" type="radio" name="view" /><label for="pages">Full article pages</label>
    <div class="comparison">
      {versions.map(version => <section>
        <h2>{version.title}</h2>
        <p>Box height at 1024px width: {version.height}</p>
        <a class="box-view" href={`/design-review/${version.id}-demo.png`}><img src={`/design-review/${version.id}-demo.png`} alt={`${version.title}: phased-array demo box`} width="1024" height={version.id === 'original' ? 574 : 914} /></a>
        <a class="page-view" href={`/design-review/${version.id}-page.png`}><img src={`/design-review/${version.id}-page.png`} alt={`${version.title}: full phased-array article`} loading="lazy" /></a>
      </section>)}
    </div>
  </div>
</BaseLayout>
<style>
.review { max-width: 2200px; margin: 0 auto; padding: 2rem var(--page-gutter); }
h1 { font-size: 1.75rem; margin-bottom: 1rem; }
.review > p { max-width: 80ch; color: var(--muted); line-height: 1.7; margin-bottom: 1rem; }
label { display: inline-block; padding: .75rem; cursor: pointer; }
input { accent-color: var(--accent); }
.comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1rem; align-items: start; }
h2 { font-size: 1.125rem; }
section p { color: var(--muted); font-size: .875rem; margin: .5rem 0 1rem; }
img { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: .5rem; }
a { display: block; }
.page-view { display: none; }
#pages:checked ~ .comparison .box-view { display: none; }
#pages:checked ~ .comparison .page-view { display: block; }
@media (max-width: 900px) { .comparison { grid-template-columns: minmax(0, 1fr); } }
</style>
