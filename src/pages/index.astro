---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts } from '../lib/posts';

const recentPosts = (await getAllPosts()).slice(0, 5);

const categoryColors: Record<string, string> = {
  antennas: 'text-zinc-500',
  ml:       'text-zinc-500',
  rf:       'text-zinc-500',
  optics:   'text-zinc-500',
  dsp:      'text-zinc-500',
  misc:     'text-zinc-500',
};

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date);
---

<BaseLayout title="frah90" description="RF & Photonics Engineer. Technical writing on antennas, RF, optical systems, and signal processing.">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Hero -->
    <section class="pt-12 pb-10 border-b border-zinc-900">
      <p class="text-sm text-zinc-300 mb-1">RF &amp; Photonics Engineer</p>
      <p class="text-sm text-zinc-600">Antennas · RF · Photonics · Signal Processing</p>
    </section>

    <!-- Recent Writing -->
    {recentPosts.length > 0 && (
      <section class="py-14">
        <div class="flex items-center justify-between mb-8">
          <span class="text-xs uppercase tracking-widest text-zinc-600" style="letter-spacing: 0.12em;">Recent</span>
          <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">All posts →</a>
        </div>

        <ul class="space-y-0">
          {recentPosts.map((post, i) => (
            <li class={i > 0 ? 'border-t border-zinc-900' : ''}>
              <a href={`/blog/${post.id}`} class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-12 py-5">
                <div class="min-w-0 max-w-xl">
                  <h2 class="text-lg text-zinc-200 group-hover:text-zinc-50 transition-colors leading-snug mb-1.5"
                    style="font-family: 'Lora', Georgia, serif; font-weight: 400;">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-zinc-600 leading-relaxed">{post.data.description}</p>
                </div>
                <div class="flex sm:flex-col items-center sm:items-end gap-3 sm:gap-1 shrink-0">
                  <span class:list={['text-xs font-mono text-zinc-400', categoryColors[post.data.category] ?? 'text-zinc-400']}>
                    {post.data.category}
                  </span>
                  <time class="text-xs text-zinc-600 tabular-nums">{fmt(post.data.date)}</time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</BaseLayout>
