---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteName, cvUrl } from '../lib/site';

const subjectGroups = [
  {
    label: 'Antennas & Arrays',
    items: ['Phased array design', 'Array factor analysis', 'Beam steering', 'Near/far field', 'HFSS / CST'],
  },
  {
    label: 'RF & Microwave',
    items: ['Transmission line theory', 'Smith chart / impedance matching', 'S-parameters', 'LTspice', 'VNA measurements'],
  },
  {
    label: 'Optics & Photonics',
    items: ['Gaussian beam propagation', 'Mode field analysis', 'Fiber optics', 'Optical resonators', 'Dispersion modeling'],
  },
  {
    label: 'Signal Processing',
    items: ['Fourier analysis (DFT/FFT)', 'Filter design (FIR/IIR)', 'Spectral estimation', 'Windowing', 'Sampling theory'],
  },
  {
    label: 'Simulation & Software',
    items: ['Python (NumPy, SciPy, Plotly)', 'MATLAB / Octave', 'Jupyter notebooks', 'Git', 'Linux'],
  },
  {
    label: 'Machine Learning',
    items: ['Neural networks (PyTorch)', 'Applied ML for signal data', 'Feature engineering', 'Model evaluation'],
  },
];
---
<BaseLayout title={`About — ${siteName}`} description="An electronic engineer’s interests in waves, signals, and engineering software.">
  <article class="site-shell py-12 sm:py-16">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold text-ink mb-8">About</h1>
      <div class="prose max-w-none mb-12">
        <p>I’m an electronic engineer interested in electronics, photonics, RF systems, and signal processing.</p>
        <p>This site is a place to work through engineering ideas from first principles, with equations, code, and interactive examples.</p>
      </div>
      <h2 class="text-xs font-mono uppercase tracking-widest text-muted mb-6">Topics &amp; tools</h2>
      <p class="text-sm text-muted mb-6">Areas of interest for study and practical exploration.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {subjectGroups.map(group => <section class="border border-rule rounded-lg p-5 min-w-0">
          <h3 class="text-xs font-mono uppercase tracking-widest text-accent mb-4">{group.label}</h3>
          <ul class="space-y-1.5">{group.items.map(item => <li class="text-sm text-body flex items-start gap-2"><span class="text-muted" aria-hidden="true">—</span>{item}</li>)}</ul>
        </section>)}
      </div>
      {cvUrl && <a href={cvUrl} class="inline-flex min-h-11 items-center text-accent underline underline-offset-4 mt-8">Download CV (PDF)</a>}
    </div>
  </article>
</BaseLayout>
