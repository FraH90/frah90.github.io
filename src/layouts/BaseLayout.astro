---
import '../styles/global.css';
import Header from '../components/nav/Header.astro';
import { cvUrl, siteName, siteDescription } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = siteDescription,
  ogImage = '/og-default.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col" style="font-family: 'Inter', system-ui, sans-serif;">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 min-w-0">
      <slot />
    </main>
    <footer class="border-t border-zinc-800 py-8 mt-16">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-zinc-400">
        <span>&copy; {new Date().getFullYear()} {siteName}</span>
        <div class="flex flex-wrap justify-center gap-6">
          <a href="https://github.com/FraH90" target="_blank" rel="noopener" class="hover:text-zinc-200 transition-colors">GitHub</a>
          <a href="/about" class="hover:text-zinc-200 transition-colors">About</a>
          {cvUrl && <a href={cvUrl} target="_blank" rel="noopener" class="hover:text-zinc-200 transition-colors">CV</a>}
        </div>
      </div>
    </footer>
  </body>
</html>
