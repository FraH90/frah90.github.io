---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TagBadges from '../components/blog/TagBadges.astro';
import { getPostTags } from '../lib/tags';
import { siteName } from '../lib/site';
import ArticleReferences from '../components/article/ArticleReferences.astro';
import PostCard from '../components/blog/PostCard.astro';
import { articleDisplayTitle, demoLabel, demoNotice } from '../lib/article-status';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: CollectionEntry<'blog'>[];
}
const { post, headings, relatedPosts } = Astro.props;
const { demo, title, date, category, description, learningGoals, prerequisites, takeaways, resources, references } = post.data;
const contents = [
  ...headings,
  ...(takeaways.length ? [{ depth: 2, slug: 'article-tools-takeaways', text: 'Key takeaways' }] : []),
  ...(resources.length ? [{ depth: 2, slug: 'article-tools-resources', text: 'Supporting material' }] : []),
  ...(references.length ? [{ depth: 2, slug: 'article-tools-references', text: 'References' }] : []),
  ...(relatedPosts.length ? [{ depth: 2, slug: 'article-tools-related', text: 'Related reading' }] : []),
];

const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(date);

---

<BaseLayout articleContents={contents} title={`${articleDisplayTitle(title, demo)} — ${siteName}`} description={demo ? `${demoNotice} ${description}` : description}>
  <article class="site-shell article-layout py-12 sm:py-16" data-pagefind-body data-article-demo={demo ? "true" : undefined}>
    <header class="reading-width mb-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-6">
        <span class="sr-only" data-pagefind-meta="tagIds">{post.data.tags.join(' ')}</span>
        <span class="sr-only" data-pagefind-meta="tags">{getPostTags(post).map(tag => tag.label).join(', ')}</span>
        <TagBadges tags={post.data.tags} />
        {demo && <span class="demo-info">
          <button type="button" class="demo-badge" aria-describedby="demo-explanation" data-pagefind-meta="status">{demoLabel}</button>
          <span id="demo-explanation" class="demo-tooltip" role="tooltip" data-pagefind-ignore>{demoNotice}</span>
        </span>}
        <span class="text-muted">·</span>
        <time datetime={date.toISOString()} class="text-sm text-muted">{formatted}</time>
      </div>
      <h1 data-pagefind-meta="title" class="page-title text-3xl sm:text-4xl text-ink leading-tight mb-4"
        style="font-family: 'Lora', Georgia, serif; font-weight: 400;">
        {title}
      </h1>
      <p class="text-base text-muted leading-relaxed" style="font-family: 'Lora', Georgia, serif; font-style: italic;">
        {description}
      </p>
    </header>

    {(learningGoals.length > 0 || prerequisites.length > 0) && (
      <div class="article-brief reading-width mb-8">
        {learningGoals.length > 0 && <div>
          <h2 class="text-sm font-medium text-ink mb-3">What you’ll learn</h2>
          <ul class="space-y-2 list-disc pl-5">{learningGoals.map(goal => <li>{goal}</li>)}</ul>
        </div>}
        {prerequisites.length > 0 && <p class="mt-4"><strong class="text-ink font-medium">Prerequisites: </strong>{prerequisites.join('; ')}.</p>}
      </div>
    )}
    <div class="prose article-content">
      <slot />
    </div>

    {takeaways.length > 0 && <section class="article-takeaways reading-width mt-10" aria-labelledby="article-tools-takeaways">
      <h2 id="article-tools-takeaways" tabindex="-1" class="text-sm font-medium text-ink mb-3">Key takeaways</h2>
      <ul class="list-disc pl-5 space-y-2">{takeaways.map(takeaway => <li>{takeaway}</li>)}</ul>
    </section>}

    {resources.length > 0 && <section class="article-section reading-width" aria-labelledby="article-tools-resources">
      <h2 id="article-tools-resources" tabindex="-1" class="article-section-title">Supporting material</h2>
      <ul class="space-y-3">{resources.map(resource => <li>
        <a href={resource.url} class="text-accent underline underline-offset-4">{resource.label}</a>
        {resource.kind !== 'other' && <span class="text-muted text-xs ml-2 capitalize">{resource.kind}</span>}
      </li>)}</ul>
    </section>}
    <ArticleReferences references={references} />
    {relatedPosts.length > 0 && <section class="article-section" aria-labelledby="article-tools-related">
      <h2 id="article-tools-related" tabindex="-1" class="article-section-title">Related reading</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{relatedPosts.map(related => (
        <PostCard post={related} headingLevel={3} />
      ))}</div>
    </section>}

  </article>
</BaseLayout>

<script>
  for (const info of document.querySelectorAll<HTMLElement>('.demo-info')) {
    const badge = info.querySelector<HTMLButtonElement>('button')!;
    const reset = () => { delete info.dataset.dismissed; };
    info.addEventListener('mouseleave', reset);
    info.addEventListener('focusout', reset);
    badge.addEventListener('keydown', event => {
      if (event.key === 'Escape') info.dataset.dismissed = 'true';
    });
  }

  // Wide scientific material scrolls locally and remains reachable by keyboard.
  for (const [selector, label] of [['pre', 'Code block'], ['table', 'Table'], ['.katex-display', 'Equation']]) {
    for (const element of document.querySelectorAll<HTMLElement>(`.article-content ${selector}`)) {
      if (element.hasAttribute('tabindex')) continue;
      const originalLabel = element.getAttribute('aria-label');
      const originalRole = element.getAttribute('role');
      const update = () => {
        const overflowing = element.scrollWidth > element.clientWidth;
        if (overflowing) {
          element.tabIndex = 0;
          if (originalLabel === null) element.setAttribute('aria-label', `${label} — scroll horizontally`);
          if (selector !== 'table' && originalRole === null) element.setAttribute('role', 'region');
        } else {
          element.removeAttribute('tabindex');
          if (originalLabel === null) element.removeAttribute('aria-label');
          if (selector !== 'table' && originalRole === null) element.removeAttribute('role');
        }
      };
      const observer = new ResizeObserver(update);
      observer.observe(element);
      update();
    }
  }
</script>
