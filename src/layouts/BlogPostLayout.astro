---
import BaseLayout from './BaseLayout.astro';
import { getTopic, type TopicSlug } from '../lib/topics';
import { siteName } from '../lib/site';

interface Props {
  title: string;
  date: Date;
  category: TopicSlug;
  description: string;
  tags: string[];
}

const { title, date, category, description } = Astro.props;
const topic = getTopic(category);

const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(date);

---

<BaseLayout title={`${title} — ${siteName}`} description={description}>
  <article class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-12 pb-10 border-b border-zinc-900">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-6">
        <a
          href={`/blog/${category}`}
          class:list={['inline-flex min-h-11 items-center text-sm hover:underline underline-offset-4', topic.color]}
        >
          {topic.label}
        </a>
        <span class="text-zinc-800">·</span>
        <time datetime={date.toISOString()} class="text-sm text-zinc-400">{formatted}</time>
      </div>
      <h1 class="text-3xl sm:text-4xl text-zinc-100 leading-tight mb-4"
        style="font-family: 'Lora', Georgia, serif; font-weight: 400;">
        {title}
      </h1>
      <p class="text-base text-zinc-500 leading-relaxed" style="font-family: 'Lora', Georgia, serif; font-style: italic;">
        {description}
      </p>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none
      prose-headings:text-zinc-100
      prose-p:text-zinc-300 prose-p:leading-relaxed
      prose-a:text-emerald-400 prose-a:no-underline hover:prose-a:underline
      prose-code:text-emerald-300 prose-code:bg-zinc-800/80 prose-code:px-1.5 prose-code:rounded prose-code:text-sm
      prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800
      prose-strong:text-zinc-200
      prose-li:text-zinc-300"
      style="font-family: 'Lora', Georgia, serif;">
      <slot />
    </div>

    <div class="mt-16 pt-8 border-t border-zinc-900">
      <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">
        ← All writing
      </a>
    </div>
  </article>
</BaseLayout>
